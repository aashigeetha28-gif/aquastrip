# ====================================================================
# Cl-Ladder Environment Variables (.env)
# ====================================================================

# Supabase Project Configuration (PostgreSQL + REST + Auth)
# Get these from your Supabase Dashboard: Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# SMS Alert Gateway (Phase 3)
EXPO_PUBLIC_SMS_GATEWAY_PROVIDER=MSG91
EXPO_PUBLIC_SMS_API_KEY=your-msg91-or-fast2sms-api-key

# JJM District & App Mode
EXPO_PUBLIC_DEFAULT_DISTRICT=Pune
EXPO_PUBLIC_APP_ENV=development
